# ==============================================================================
# AI Business Intelligence & Financial Analysis Agent - Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME="AI Business Intelligence & Financial Analysis Agent"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG=True
API_HOST="127.0.0.1"
API_PORT=8000

# Database Configuration
# Default is local SQLite. For PostgreSQL: postgresql://user:password@localhost:5432/bi_db
DATABASE_URL="sqlite:///./data/business_bi.db"
DB_ECHO=False
SQL_MAX_ROWS=1000
SQL_EXECUTION_TIMEOUT_SECONDS=5.0

# LLM Provider Configuration
# Options:
#  - "mock"    : Deterministic fallback engine (Requires NO external API key; runs completely offline and free)
#  - "gemini"  : Google Gemini via LangChain (Set GEMINI_API_KEY or GOOGLE_API_KEY)
#  - "openai"  : OpenAI GPT models via LangChain (Set OPENAI_API_KEY)
#  - "auto"    : Automatically detects provider based on provided API keys
LLM_PROVIDER="mock"
LLM_MODEL_NAME="gpt-4o-mini"
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# API Keys (Uncomment and populate if using cloud LLM providers)
# GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# MCP (Model Context Protocol) Server
MCP_SERVER_NAME="business-intelligence-mcp"
MCP_HOST="127.0.0.1"
MCP_PORT=8001
